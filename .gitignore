# Third-party binaries — 1.1 GB of Quantum Espresso + Intel MKL DLLs were
# tracked here. Install them with dft/install_qe.py instead of versioning them.
**/qe_binaries/

# Old unrelated clone, kept locally only
_archive/

# Training artefacts: checkpoints are 2.7 MB each and there are thousands.
# Metrics belong in research-vault/Experiment Log.md, not in git history.
**/checkpoint_*.pt
**/*.pt
**/runs/
**/results_crystal_*/
**/results_eval*/
**/results_analysis/
**/experiments/

# Logs
*.log
**/stdout*.log
**/stderr.log

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data caches (regenerate with datasets/*.py)
**/relaxed_structures.pkl

# Benchmark CIF exports (regenerate with benchmark.py)
bench_out/

# Rebuilt by datasets/rebuild_dataset.py
datasets/unique_sc_mgmno.npy
datasets/unique_sc_mgmno_name_list

# S.U.N. tracker output
**/sun_track.csv
**/epoch_log_from_stdout.csv

